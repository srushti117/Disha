# Copy to .env and edit. NEVER commit real secrets.
# --- core ---
JWT_SECRET=replace-with-a-long-random-string        # python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-me
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# --- demo ---
DEMO_MODE=true
SEED_DEMO_ACCOUNTS=true          # set false in any real deployment (demo password is public)
DEMO_PASSWORD=Disha@2026         # DEMO ONLY
# --- notifications (mock by default: nothing is sent) ---
NOTIFY_PROVIDER=mock
